<Window x:Class="RocketChat.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rocket.Chat C#" Width="1180" Height="760" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="White">
  <Grid>
    <Grid x:Name="LoginView" Background="#F2F4F7">
      <Border Width="420" Padding="36" Background="White" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="22" Opacity="0.12" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Rocket.Chat" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource RocketDark}"/>
          <TextBlock Text="C# 原生桌面客户端" Margin="0,4,0,28" Foreground="#68727D"/>
          <TextBlock Text="服务器" Margin="0,0,0,6"/>
          <TextBox x:Name="ServerBox" Text="https://open.rocket.chat/" Margin="0,0,0,14"/>
          <TextBlock Text="用户名或邮箱" Margin="0,0,0,6"/>
          <TextBox x:Name="UsernameBox" Margin="0,0,0,14"/>
          <TextBlock Text="密码" Margin="0,0,0,6"/>
          <PasswordBox x:Name="PasswordBox" Padding="8,6" Margin="0,0,0,18" KeyDown="PasswordBox_KeyDown"/>
          <Button x:Name="LoginButton" Content="登录" Background="{StaticResource RocketBlue}" Foreground="White" FontWeight="SemiBold" Click="LoginButton_Click"/>
          <TextBlock x:Name="LoginStatus" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#C83D3D"/>
          <TextBlock Text="密码仅用于本次登录，不会保存到磁盘。" Margin="0,18,0,0" Foreground="#7C8792" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="ChatView" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource RocketDark}">
        <Grid Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="WorkspaceName" Text="Rocket.Chat" Foreground="White" FontWeight="SemiBold" FontSize="18"/>
              <TextBlock x:Name="CurrentUser" Foreground="#AEB7C2" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1" Content="＋" ToolTip="新建会话或频道" Background="#343A42" Foreground="White" Click="NewConversation_Click"/>
          </Grid>
          <TextBox x:Name="RoomFilterBox" Grid.Row="1" Margin="0,16,0,10" TextChanged="RoomFilterBox_TextChanged" ToolTip="筛选会话"/>
          <ListBox x:Name="RoomList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="RoomList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="3,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Icon}" Foreground="#AFC5D5"/>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                  <Border Grid.Column="2" Background="#E05252" CornerRadius="9" Padding="5,1" Visibility="{Binding Unread, Converter={StaticResource UnreadVisibilityConverter}}">
                    <TextBlock Text="{Binding UnreadLabel}" Foreground="White" FontSize="10"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RealtimeStatus" Foreground="#98A4AF" VerticalAlignment="Center" FontSize="11" Text="REST 模式"/>
            <Button Grid.Column="1" Content="退出" Background="#343A42" Foreground="White" Click="Logout_Click"/>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="62"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="#E5E8EC" BorderThickness="0,0,0,1" Padding="18,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="RoomTitle" Text="选择一个会话" FontWeight="SemiBold" FontSize="18"/>
              <TextBlock x:Name="RoomSubtitle" Foreground="#77818C" FontSize="11"/>
            </StackPanel>
            <TextBox x:Name="MessageSearchBox" Grid.Column="1" ToolTip="搜索当前会话，按 Enter" KeyDown="MessageSearchBox_KeyDown"/>
          </Grid>
        </Border>
        <Border x:Name="SearchBanner" Grid.Row="1" Background="#FFF4CF" Padding="12,6" Visibility="Collapsed">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="清除" Padding="7,2" Click="ClearSearch_Click"/>
            <TextBlock x:Name="SearchLabel" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <ListBox x:Name="MessageList" Grid.Row="2" BorderThickness="0" Background="White" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="回复" Click="ReplyMessage_Click"/>
              <MenuItem Header="编辑" Click="EditMessage_Click"/>
              <MenuItem Header="添加 👍" Click="ReactMessage_Click"/>
              <Separator/>
              <MenuItem Header="删除" Foreground="#C43A3A" Click="DeleteMessage_Click"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="#DDEAF2" VerticalAlignment="Top">
                  <TextBlock Text="{Binding AuthorInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#286B91"/>
                </Border>
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AuthorLabel}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TimeLabel}" Margin="8,2,0,0" FontSize="11" Foreground="#8B949E"/>
                    <TextBlock Text="{Binding EditedLabel}" Margin="5,2,0,0" FontSize="11" Foreground="#8B949E"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="14"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="3" BorderBrush="#E5E8EC" BorderThickness="0,1,0,0" Padding="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="ReplyBanner" Background="#EEF5FA" Padding="8,4" Margin="0,0,0,7" Visibility="Collapsed">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Padding="5,0" Click="CancelReply_Click"/>
                <TextBlock x:Name="ReplyLabel" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Border>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button Content="📎" FontSize="17" Background="#EFF2F5" ToolTip="上传文件" Click="Upload_Click"/>
              <TextBox x:Name="ComposerBox" Grid.Column="1" Margin="8,0" AcceptsReturn="True" MaxHeight="110" VerticalScrollBarVisibility="Auto" KeyDown="ComposerBox_KeyDown" ToolTip="输入消息；Enter 发送，Shift+Enter 换行"/>
              <Button x:Name="SendButton" Grid.Column="2" Content="发送" Background="{StaticResource RocketBlue}" Foreground="White" Click="Send_Click"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
