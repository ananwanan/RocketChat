<Application x:Class="RocketChat.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <local:UnreadVisibilityConverter x:Key="UnreadVisibilityConverter" xmlns:local="clr-namespace:RocketChat.Client"/>
    <SolidColorBrush x:Key="RocketBlue" Color="#13679A"/>
    <SolidColorBrush x:Key="RocketDark" Color="#1F2329"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F8FA"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="#CCD2D8"/>
    </Style>
  </Application.Resources>
</Application>
